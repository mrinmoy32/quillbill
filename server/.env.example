# Copy to server/.env (git-ignored). SECRETS ONLY. Non-secret config lives in server/config/.
APP_ENV=local

# Same RDS instance as dev. Tip: use a separate database (app_local) so local experiments never touch dev data.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-RDS-ENDPOINT:5432/app_local?sslmode=require

# Razorpay (use TEST mode keys locally). Optional until you work on billing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
